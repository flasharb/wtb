# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

# Service & Server
PUBLIC_BASE_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whale_tracker
REDIS_URL=redis://localhost:6379

# Solana: Helius
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH_HEADER=
HELIUS_MONTHLY_CREDIT_BUDGET=1000000

# Ethereum: Alchemy
ALCHEMY_API_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Optional Whale Sources
DUNE_API_KEY=

# Birdeye (optional enrichment; free key lacks token_security)
BIRD_EYE_KEY=

# New-Launch Scanner (primary product)
# Broadcast alerts to a channel (bot must be admin). e.g. @stackalphacalls or -1001234567890
ALERT_CHANNEL_ID=
# Paid VIP (Telegram Stars): private channel id (bot must be admin w/ invite+ban rights)
VIP_CHANNEL_ID=
SUB_PRICE_STARS=1000
SUB_DAYS=30
TEASER_ENABLED=true
SCAN_ENABLED=true
SCAN_INTERVAL_MIN=10
SCAN_MIN_AGE_DAYS=7
SCAN_MAX_AGE_DAYS=30
SCAN_MIN_LIQUIDITY_USD=30000
SCAN_MIN_VOLUME_24H_USD=10000
SCAN_MAX_TOP10_PCT=60
SCAN_MIN_HOLDERS=100
SCAN_MAX_ALERTS_PER_CYCLE=5
SCAN_FADE_MULT=0.5
SCAN_RUG_LIQUIDITY_USD=5000

# ---- Auto-trading (VIP sniper) ----
# Master kill-switch for buying/selling. Leave false until you've funded + tested.
TRADING_ENABLED=false
# REQUIRED to enable trading: 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this. Rotating it permanently orphans every existing user wallet.
WALLET_ENCRYPTION_KEY=
# Optional: dedicated Solana RPC (defaults to your Helius key, else public mainnet).
SOLANA_RPC_URL=
# Jupiter swap API (lite = free, no key). Paid tier: https://api.jup.ag/swap/v1 + JUPITER_API_KEY
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
TRADE_PRIORITY_FEE_LAMPORTS=300000
TRADE_FEE_RESERVE_SOL=0.03
TRADE_MAX_BUY_SOL=5
TRADE_MONITOR_INTERVAL_SEC=20
# Per-user defaults (each VIP can override via the bot)
TRADE_DEFAULT_BUY_SOL=0.1
TRADE_DEFAULT_TP_PCT=100
TRADE_DEFAULT_SL_PCT=40
TRADE_DEFAULT_TRAIL_PCT=25
TRADE_DEFAULT_TP_SELL_PCT=50
TRADE_DEFAULT_SLIPPAGE_BPS=1500
TRADE_DEFAULT_MAX_CONCURRENT=5
TRADE_DEFAULT_MAX_DAILY_BUYS=20

# Whale Filtering & Budget Parameters
MVP_WALLET_CAP=1000
MIN_WALLET_USD=100000
MIN_SWAPS_30D=10
MAX_SWAPS_PER_DAY=40
AUTO_TRIM=true

# Buy Classification & Signals
MIN_BUY_USD=5000
MIN_WHALES=3
WINDOW_HOURS=6
HIGH_CONVICTION_USD=50000
MIN_LIQUIDITY_USD=50000
MIN_TOKEN_AGE_MIN=30
