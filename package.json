{
  "name": "whale-buy-tracker",
  "version": "0.1.0",
  "description": "Telegram Whale Buy Tracker (Solana + Ethereum)",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "seed:wallets": "tsx src/scripts/seed-wallets.ts",
    "sync:webhooks": "tsx src/scripts/sync-webhooks.ts",
    "test:alchemy": "tsx src/scripts/test-alchemy-getlogs.ts",
    "test": "tsx --test tests/filter-engine.test.ts tests/solana-classifier.test.ts tests/ethereum-classifier.test.ts tests/ingestion-idempotency.test.ts tests/market-security.test.ts tests/telegram-burst-alert.test.ts"
  },
  "keywords": [
    "solana",
    "ethereum",
    "whale",
    "tracker",
    "telegram"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bip39": "3.1.0",
    "bs58": "6.0.0",
    "bullmq": "^5.41.6",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "ed25519-hd-key": "1.3.0",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "ioredis": "^5.5.0",
    "jose": "5.9.6",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tweetnacl": "1.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
