# Backend API base (the Fastify service). The web app reads all data from here —
# it does NOT connect to the database directly.
#   local dev:  http://localhost:3000
#   production: https://api.stackalpha.xyz   (put the API behind HTTPS for prod)
API_URL=http://localhost:3000

# Read-only Solana RPC for the wallet adapter (balance reads only).
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Public site config (safe to expose; baked into the client at build time).
NEXT_PUBLIC_SITE_URL=https://stackalpha.xyz
NEXT_PUBLIC_BOT_URL=https://t.me/stackalpha_bot
NEXT_PUBLIC_FREE_CHANNEL_URL=https://t.me/stackalphaa
NEXT_PUBLIC_SUB_PRICE_STARS=1000
NEXT_PUBLIC_SUB_DAYS=30
